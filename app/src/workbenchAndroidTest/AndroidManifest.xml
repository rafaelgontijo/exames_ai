<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <application android:allowBackup="false">
        <provider android:name="br.com.exames.app.AuthorizedExampleProvider"
            android:authorities="${applicationId}.authorized-example" android:exported="false"
            android:grantUriPermissions="true" />
        <provider android:name="br.com.exames.app.SyntheticDocumentsProvider"
            android:authorities="${applicationId}.synthetic-documents" android:exported="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" android:grantUriPermissions="true">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name="br.com.exames.app.SyntheticSummaryReceiver" android:label="Leitor sintético local" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Only the test APK exposes this read-only synthetic fixture. No production provider. -->
        <provider android:name="br.com.exames.app.WorkbenchSyntheticProvider"
            android:authorities="${workbenchFixtureAuthority}"
            android:exported="true" android:grantUriPermissions="true" />
    </application>
</manifest>
