{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "version",
    "reviewState",
    "reviewerId",
    "reviewedAt",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "PENDING",
        "REVIEWED"
      ]
    },
    "reviewerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observationId",
          "analyte",
          "analyteRaw",
          "resultRaw",
          "unitRaw",
          "referenceRaw",
          "numericValue",
          "low",
          "high",
          "expectedStatus",
          "expectedReason",
          "recoverable",
          "evidence"
        ],
        "properties": {
          "observationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "analyte": {
            "type": "string",
            "enum": [
              "GLUCOSE",
              "UREA",
              "CREATININE",
              "SODIUM",
              "POTASSIUM"
            ]
          },
          "analyteRaw": {
            "type": "string",
            "minLength": 1
          },
          "resultRaw": {
            "type": "string"
          },
          "unitRaw": {
            "type": [
              "string",
              "null"
            ]
          },
          "referenceRaw": {
            "type": [
              "string",
              "null"
            ]
          },
          "numericValue": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
          },
          "low": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
          },
          "high": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[+-]?[0-9]+(?:\\.[0-9]+)?$"
          },
          "expectedStatus": {
            "type": "string",
            "enum": [
              "BELOW_RANGE",
              "WITHIN_RANGE",
              "ABOVE_RANGE",
              "NOT_CLASSIFIABLE",
              "NEEDS_REVIEW"
            ]
          },
          "expectedReason": {
            "type": "string",
            "minLength": 1
          },
          "recoverable": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "raw",
                "region",
                "spanId",
                "method",
                "extractorVersion",
                "confidence"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "analyteRaw",
                    "resultRaw",
                    "unitRaw",
                    "referenceRaw"
                  ]
                },
                "raw": {
                  "type": "string"
                },
                "region": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "page",
                    "left",
                    "top",
                    "right",
                    "bottom",
                    "pageWidth",
                    "pageHeight",
                    "rotationDegrees"
                  ],
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "left": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20000
                    },
                    "top": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20000
                    },
                    "right": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20000
                    },
                    "bottom": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20000
                    },
                    "pageWidth": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20000
                    },
                    "pageHeight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20000
                    },
                    "rotationDegrees": {
                      "type": "integer",
                      "enum": [
                        0,
                        90,
                        180,
                        270
                      ]
                    }
                  }
                },
                "spanId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "extractorVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
