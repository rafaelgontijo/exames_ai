{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusVersion",
    "generatorVersion",
    "seed",
    "fontSha256",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "corpusVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatorVersion": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "fontSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "familyId",
          "origin",
          "format",
          "partition",
          "layoutId",
          "layoutVersion",
          "documentPath",
          "documentSha256",
          "documentBytes",
          "groundTruthPath",
          "groundTruthSha256",
          "transformations",
          "provenance"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "familyId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "SYNTHETIC",
              "PUBLIC_DEMONSTRATION"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "PDF_TEXT",
              "PDF_SCANNED",
              "PNG",
              "JPEG"
            ]
          },
          "partition": {
            "type": "string",
            "enum": [
              "DEVELOPMENT",
              "HELD_OUT"
            ]
          },
          "layoutId": {
            "type": "string",
            "minLength": 1
          },
          "layoutVersion": {
            "type": "string",
            "minLength": 1
          },
          "documentPath": {
            "type": "string",
            "minLength": 1
          },
          "documentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "documentBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "groundTruthPath": {
            "type": "string",
            "minLength": 1
          },
          "groundTruthSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "transformations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "provenance": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "obtainedOn",
                  "reuseTerms",
                  "eligibilityReviewed",
                  "containsIdentifiableData"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "obtainedOn": {
                    "type": "string",
                    "format": "date"
                  },
                  "reuseTerms": {
                    "type": "string",
                    "minLength": 1
                  },
                  "eligibilityReviewed": {
                    "type": "boolean"
                  },
                  "containsIdentifiableData": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
